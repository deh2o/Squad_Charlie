# Copy to .env and fill in before running app.py if you want real emails.
# Without EMAIL_PASS the app runs in DRY RUN mode: alerts are printed,
# not sent. Use a Gmail 16-character App Password, not your account password.

# Email configuration
TECH_EMAIL=tech@example.com
SENDER_EMAIL=your-email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=true
EMAIL_PASS=your-16-char-gmail-app-password

# Troubleshooting:
# If you get timeout errors, try:
# 1. Change SMTP_PORT to 465 and SMTP_USE_SSL to true
# 2. Check your firewall/network settings
# 3. Try a different network connection
# 4. Make sure 2-Step Verification is enabled on your Google Account
